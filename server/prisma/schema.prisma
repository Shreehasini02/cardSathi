generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PaymentStatus {
  UPCOMING
  PAID
  OVERDUE
}

enum NotificationType {
  PAYMENT
  INSIGHT
  SYSTEM
}

model User {
  id            String             @id @default(cuid())
  name          String
  email         String             @unique
  passwordHash  String
  role          Role               @default(USER)
  language      String             @default("en")
  dashboardMode String             @default("advanced")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  cards         CreditCard[]
  transactions  Transaction[]
  budgets       Budget[]
  payments      Payment[]
  notifications Notification[]
  insights      FinancialInsight[]
}

model CreditCard {
  id          String        @id @default(cuid())
  userId      String
  name        String
  last4       String        @db.VarChar(4)
  network     String        @default("VISA")
  creditLimit Decimal       @db.Decimal(12, 2)
  billingDay  Int?
  dueDay      Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  payments    Payment[]
  @@index([userId])
}

model Category {
  id           String        @id @default(cuid())
  name         String        @unique
  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id         String     @id @default(cuid())
  userId     String
  cardId     String
  categoryId String
  merchant   String
  amount     Decimal    @db.Decimal(12, 2)
  date       DateTime
  note       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card       CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id])
  @@index([userId, date])
  @@index([cardId, date])
  @@index([categoryId])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  amount     Decimal  @db.Decimal(12, 2)
  month      DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  cardId         String
  amount         Decimal       @db.Decimal(12, 2)
  dueDate        DateTime
  paidAt         DateTime?
  status         PaymentStatus @default(UPCOMING)
  isSimulated    Boolean       @default(true)
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  card           CreditCard    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  @@index([userId, dueDate])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String
  type      NotificationType @default(SYSTEM)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model FinancialInsight {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model UsageEvent {
  id        String   @id @default(cuid())
  kind      String
  createdAt DateTime @default(now())
  @@index([kind, createdAt])
}
